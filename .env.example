# =============================================================================
# AI UNIFIED LIFE COMPANION — ENVIRONMENT CONFIGURATION
# Platform: PHP 8+, MySQL (PDO), XAMPP Apache
# =============================================================================

# Database Credentials (MySQL / XAMPP default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_life_companion
DB_USER=root
DB_PASS=

# AI Provider Configuration (OpenAI, Gemini via OpenAI compatibility, Groq, Ollama)
AI_API_KEY=your-openai-api-key-here
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=18

# Application Settings
APP_NAME="AI Unified Life Companion"
APP_ENV=development
APP_URL=http://localhost/ai-life-companion
